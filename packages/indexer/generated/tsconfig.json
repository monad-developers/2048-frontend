{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "generated": ["."],
      "generated/*": ["./*"]
    }
  },
  "include": ["src/**/*", "../src/**/*"],
  "exclude": ["node_modules"]
}
